# scripts/start-local.sh or scripts/start-local.ps1 generates random local credentials.
APP_TOKEN=
POSTGRES_PASSWORD=
APP_PORT=8765

# DeepSeek is optional for manual drafts. Never place the key in the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# URLs must be reachable from the app process. For Docker, localhost is the container.
TTS_BASE_URL=
TTS_API_KEY=
LIVETALKING_BASE_URL=

# Optional CPU semantic retrieval. Leave both empty for explicit keyword mode.
BGE_BASE_URL=
BGE_API_KEY=
# Used only with compose.bge.yaml. Absolute local directory containing pinned weights.
BGE_MODEL_DIR=
# For the optional internal BGE container, uncomment BOTH lines and set its key/model directory.
# These settings persist the overlay for start, doctor, backup, restore and stop commands.
# COMPOSE_FILE=compose.yaml,compose.bge.yaml
# COMPOSE_PATH_SEPARATOR=,

# Optional official Taobao TOP adapter. The credentials are bound to ONE local shop.
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_SHOP_ID=
TAOBAO_GATEWAY=https://gw.api.taobao.com/router/rest
TAOBAO_TMC_GROUP=default
# Enable only after configuring the app's comment topic and local room binding.
TAOBAO_POLL_ENABLED=0
