# scripts/start-local.sh or scripts/start-local.ps1 generates random local credentials.
APP_TOKEN=
POSTGRES_PASSWORD=
APP_PORT=8765

# DeepSeek is optional for manual drafts. Never place the key in the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# URLs must be reachable from the app process. For Docker, localhost is the container.
TTS_BASE_URL=
TTS_API_KEY=
LIVETALKING_BASE_URL=
